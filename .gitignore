# Dependencies (install with `composer install` / `npm ci`)
/vendor/
/node_modules/

# Build output (`npm run build:blocks`, `composer release`)
/build/
/release/

# Tooling caches
/.phpunit.cache/
/.phpunit.result.cache

# Generated files
/tree.txt
/svn/
*.zip

# IDE and OS files
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.log
*.swp
*~

# Local config and secrets
/.env
/.env.*
/.wp-env.override.json

# Local agent settings
/.claude/settings.local.json

# Local database dumps (can contain API keys)
*.sql
