# Files and folders excluded from the release zip (`composer release`).
# Patterns starting with / are anchored to the plugin root.

# Development and build files
/node_modules/
/package-lock.json
/package.json
/yarn.lock
/composer.lock
/vendor/bin/
webpack*.js
*.config.js
/.babelrc
/.npmrc
/.nvmrc
/.eslintrc*
/.prettierrc*
/.stylelintrc*

# Development tools and configuration
/.git/
/.github/
/.gitignore
/.gitattributes
/.distignore
/.editorconfig
/phpunit.xml
/phpunit.xml.dist
/phpcs.xml
/phpcs.xml.dist
/.phpcs.xml
/.phpcs.xml.dist
/.env
/.env.*
/.wp-env.json
/.wp-env.override.json
/phpstan.neon
/.phpunit.cache/
/.phpunit.result.cache

# Tests
/tests/

# Docs and project files
/readme.md
/CHANGELOG.md
/CONTRIBUTING.md
/tree.txt
*.sh

# WordPress.org assets (deployed to SVN /assets, not the plugin)
/svn-assets/

# Release output and CI SVN checkout
/release/
/svn/

# IDE and OS files
/.vscode/
/.idea/
*.sublime-*
.DS_Store
Thumbs.db

# Temporary files and archives
*.log
*.tmp
*.cache
*.swp
*~
*.zip
*.tar.gz

# Agentic development files
/AGENTS.md
/CLAUDE.md
/.claude/
/.mcp.json
/.cursor/
/.cursorrules
/GEMINI.md
